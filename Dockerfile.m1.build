FROM rust:latest

WORKDIR /build

# Copy M1-beta contract sources
COPY m1_beta_extracted/GrowStreams_Backend-M1-beta/contracts/token-vault/ ./token-vault/
COPY m1_beta_extracted/GrowStreams_Backend-M1-beta/contracts/stream-core/ ./stream-core/

# Create minimal workspace
RUN cat > /build/Cargo.toml << 'EOF'
[workspace]
members = ["token-vault", "stream-core"]
resolver = "2"

[workspace.dependencies]
sails-rs = "0.10"
gstd = "1.10.0"
parity-scale-codec = { version = "3", default-features = false, features = ["derive"] }
scale-info = { version = "2", default-features = false, features = ["derive"] }
EOF

# Add WASM targets + rust-src (required by gear-wasm-builder)
RUN rustup target add wasm32-unknown-unknown wasm32v1-none && rustup component add rust-src

# Build one at a time
RUN cargo build --release -p token-vault
RUN cargo build --release -p stream-core

# Show results
RUN find /build/target -name "*.wasm" | head -20
